# Client-side Supabase settings (the VITE values are safe to expose in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local visual preview only. Keep disabled by default. When true, the app shows
# the dashboard shell without a Supabase session, live data, chat, presence, or
# access logging. This is ignored in a production Vite build.
VITE_LOCAL_BYPASS_AUTH=false
VITE_LOCAL_BYPASS_EMAIL=

# Server-only chatbot settings. Never prefix these with VITE_ or commit real secrets.
AI_CHAT_ENABLED=false
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-5.6-luna
AI_CHAT_REASONING_EFFORT=low
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_CHAT_ORG_ID=ghn-kas
AI_CHAT_USER_DAILY_TURNS=60
AI_CHAT_ORG_DAILY_TURNS=600
AI_CHAT_USER_DAILY_MICROUSD=500000
AI_CHAT_ORG_DAILY_MICROUSD=5000000
AI_CHAT_REQUEST_RESERVE_MICROUSD=25000
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_CHAT_MODEL_TIMEOUT_MS=20000
AI_CHAT_TURN_TIMEOUT_MS=90000

# Server-only COD SMS assessment pipeline. Keep disabled until the assessment
# migration is applied and a Dev Admin intentionally runs a manual batch.
# This reuses OPENAI_API_KEY and the server-only Supabase credentials above.
COD_SMS_AI_ENABLED=false
COD_SMS_AI_MODEL=gpt-5.6-luna
COD_SMS_AI_REASONING_EFFORT=low
COD_SMS_AI_RUBRIC_VERSION=sms-rubric-2026-09-19-v1
COD_SMS_AI_BATCH_LIMIT=25
COD_SMS_AI_MAX_BATCH_LIMIT=200
COD_SMS_AI_MAX_OUTPUT_TOKENS=1200
COD_SMS_AI_MODEL_TIMEOUT_MS=30000
COD_SMS_AI_PENDING_STALE_SECONDS=900
